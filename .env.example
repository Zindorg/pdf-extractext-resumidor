# --- Redis Streams ---
REDIS_URL=redis://localhost:6379/0
INPUT_STREAM=events:text-extracted
OUTPUT_STREAM=events:summary-generated
DLQ_STREAM=events:summary-failed
CONSUMER_GROUP=summarizer-group
CONSUMER_NAME=summarizer-worker-1
BLOCK_MS=5000
CLAIM_MIN_IDLE_MS=60000

# --- LLM (proveedor OpenAI-compatible) ---
AI_PROVIDER=openai
AI_API_KEY=changeme
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Chunking / Map-Reduce ---
CHUNK_THRESHOLD=3000
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
MAX_OUTPUT_TOKENS=1024

# --- Timeouts y reintentos ---
LLM_TIMEOUT_S=30
MAX_RETRIES=3
BACKOFF_BASE_S=1.0
BACKOFF_CAP_S=8.0

# --- Observabilidad ---
LOG_LEVEL=INFO
